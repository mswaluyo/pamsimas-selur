# ============================================================
# Environment Variables for Google Cloud Run
# ============================================================
# Set these during deployment or via gcloud CLI
# ============================================================

APP_NAME=PAMSIMAS
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pamsimas-selur-xxxxxxxxx-uc.a.run.app

# IMPORTANT: Generate a new key for production
# APP_KEY=base64:YOUR_GENERATED_KEY

# Database - Google Cloud SQL (Free tier: MySQL 10GB)
DB_CONNECTION=mysql
DB_HOST=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
DB_PORT=3306
DB_DATABASE=pamsims_db
DB_USERNAME=root
DB_PASSWORD=

# Alternative: Use Unix socket for Cloud SQL
# DB_SOCKET=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Session, Cache, Queue
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_DRIVER=database

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Filesystem - Cloud Storage
FILESYSTEM_DISK=gcs
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=

# WhatsApp Gateway
WA_GATEWAY_URL=http://your-gateway-server:3000/send-wa
WA_GATEWAY_SECRET=pamsimas-secret-key-123
WA_WEBHOOK_URL=https://pamsimas-selur-xxxxxxxxx-uc.a.run.app/api/api_wa
WA_GATEWAY_NUMBER=6285157275866

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Device API
DEVICE_API_KEY=P4mS1m4s-T1rt0-Arg0-2025

# Python OCR
EASYOCR_MODULE_PATH=/tmp/.easyocr/model
EASYOCR_USER_NETWORK_DIRECTORY=/tmp/.easyocr/user_network
PYTHON_PATH=/opt/venv/bin/python3

# Server
PORT=8080
RUN_MIGRATIONS=true

# Security
SESSION_SECURE_COOKIE=true
