# ============================================================
# PAMSIMAS - Environment Configuration untuk aaPanel Armbian
# ============================================================
# Copy file ini menjadi .env dan sesuaikan dengan server Anda
# ============================================================

APP_NAME="PAMSIMAS Selur"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pamsimas.selur.my.id

# ============================================================
# LARAVEL KEY (WAJIB: Generate dengan "php artisan key:generate")
# ============================================================
APP_KEY=

# ============================================================
# DATABASE - SQLite (Default untuk aaPanel/Armbian)
# ============================================================
DB_CONNECTION=sqlite
DB_DATABASE=/www/wwwroot/pamsimas.selur.my.id/database/database.sqlite

# ============================================================
# SESSION, CACHE, QUEUE
# ============================================================
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_DRIVER=database

# ============================================================
# LOGGING
# ============================================================
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ============================================================
# FILESYSTEM
# ============================================================
FILESYSTEM_DISK=local

# ============================================================
# STORAGE PATH - Prioritas Penyimpanan Foto Meteran
# ============================================================
# 1. Jika ada symlink ke SSD, gunakan ini:
# METER_STORAGE_PATH=/mnt/ssd_pamsimas/meter_photos
# 2. Default (lokal):
METER_STORAGE_PATH=/www/wwwroot/pamsimas.selur.my.id/storage/app/meter_photos

# ============================================================
# PYTHON OCR - Path ke Python Virtual Environment
# ============================================================
# Armbian/aaPanel (native Python venv):
PYTHON_PATH=/usr/local/bin/python_ocr
# Alternatif jika pakai venv:
# PYTHON_PATH=/www/wwwroot/pamsimas.selur.my.id/venv/bin/python3

# Path script OCR (relatif terhadap root project)
PYTHON_SCRIPT_CROP=public/smart_crop.py
PYTHON_SCRIPT_OCR=public/run_ocr.py

# Cache model EasyOCR (simpan di SSD jika ada)
EASYOCR_MODULE_PATH=/mnt/ssd_pamsimas/.easyocr/model
EASYOCR_USER_NETWORK_DIRECTORY=/mnt/ssd_pamsimas/.easyocr/user_network

# ============================================================
# WHATSAPP GATEWAY
# ============================================================
WA_GATEWAY_URL=http://127.0.0.1:3000/send-wa
WA_GATEWAY_SECRET=P4mS1m4s-T1rt0-Arg0-2025
WA_WEBHOOK_URL=https://pamsimas.selur.my.id/api/api_wa
WA_GATEWAY_NUMBER=6285157275866

# ============================================================
# GEMINI API (Opsional - untuk validasi AI)
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# DEVICE API (IoT ESP8266/ESP32)
# ============================================================
DEVICE_API_KEY=P4mS1m4s-T1rt0-Arg0-2025

# ============================================================
# SECURITY
# ============================================================
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
