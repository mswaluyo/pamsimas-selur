# ============================================================
# Environment Variables for Fly.io Deployment
# ============================================================
# Copy these to Fly.io secrets using:
#   fly secrets set KEY=VALUE
# ============================================================

APP_NAME=PAMSIMAS
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pamsimas-selur.fly.dev

# IMPORTANT: Generate new key for production
# APP_KEY=base64:generate-with-php-artisan-key-generate

# Database (SQLite on Fly.io volume)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite

# Session, Cache, Queue
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_DRIVER=database

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=info

# WhatsApp Gateway (sesuaikan dengan server gateway Anda)
WA_GATEWAY_URL=http://your-gateway-server:3000/send-wa
WA_GATEWAY_SECRET=P4mS1m4s-T1rt0-Arg0-2025
WA_WEBHOOK_URL=https://pamsimas-selur.fly.dev/api/api_wa
WA_GATEWAY_NUMBER=6285157275866

# Gemini API (untuk validasi OCR AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Device API Key
DEVICE_API_KEY=P4mS1m4s-T1rt0-Arg0-2025

# Python OCR
EASYOCR_MODULE_PATH=/var/www/html/storage/app/.easyocr/model
EASYOCR_USER_NETWORK_DIRECTORY=/var/www/html/storage/app/.easyocr/user_network
PYTHON_PATH=/opt/venv/bin/python3

# Run migrations on startup
RUN_MIGRATIONS=true

# Security
SESSION_SECURE_COOKIE=true
