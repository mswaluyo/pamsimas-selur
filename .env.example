APP_NAME="PAMSIMAS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.com

# Locale
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Maintenance
APP_MAINTENANCE_DRIVER=file

# Security
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - sesuaikan dengan konfigurasi hosting Anda
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=pamsimas_db
DB_USERNAME=user_database
DB_PASSWORD=password_database

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue & Cache
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis (opsional)
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (opsional, jika ingin notifikasi email)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hosting-anda.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifikasi@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (opsional, jika pakai cloud storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Variable untuk Vite
VITE_APP_NAME="${APP_NAME}"

# API Key untuk perangkat IoT (ESP8266)
DEVICE_API_KEY=P4mS1m4s-T1rt0-Arg0-2025

# WhatsApp Gateway Configuration
WA_GATEWAY_URL=https://domain-anda.com/api/send-wa
WA_GATEWAY_SECRET=P4mS1m4s-T1rt0-Arg0-2025
WA_WEBHOOK_URL=https://domain-anda.com/api/api_wa
WA_GATEWAY_NUMBER=6285157275866

# Gemini API Key (opsional, untuk OCR/foto meteran)
GEMINI_API_KEY=

